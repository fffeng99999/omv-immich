set -e

case "$1" in
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear|remove|purge)
		# The Immich Docker Compose stack and its data (photos, database)
		# are intentionally never touched here. Removing the plugin leaves
		# the rendered compose files and running containers in place.
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
