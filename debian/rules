#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@

# Windows checkouts do not preserve the executable bit; force the
# correct modes on the shipped scripts before packaging.
execute_before_dh_installdeb:
	chmod 0755 debian/openmediavault-immich.postinst
	chmod 0755 debian/openmediavault-immich.prerm
	chmod 0755 debian/openmediavault-immich.postrm
	chmod 0755 debian/openmediavault-immich/usr/sbin/omv-immich-ctl || true
	chmod 0755 debian/openmediavault-immich/usr/share/openmediavault/confdb/create.d/*.sh
	chmod 0755 debian/openmediavault-immich/usr/share/openmediavault/confdb/migrations.d/*.sh || true
