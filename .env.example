# Immich .env 模板（路线 A 使用；生产 omv-compose 路线不使用 .env，值直接写进栈 yml）
# 官方 example.env：https://github.com/immich-app/immich/releases/latest/download/example.env

# 照片/视频存放目录（宿主路径）
UPLOAD_LOCATION=/srv/immich/upload

# 数据库目录（宿主路径，禁止 NFS/SMB/CIFS 网络共享）
DB_DATA_LOCATION=/srv/immich/db

# 时区
TZ=Asia/Shanghai

# 版本 pin：务必写具体版本号，升级时手动改
IMMICH_VERSION=v3.2.4

# Postgres 密码：openssl rand -hex 16 生成，仅用 A-Za-z0-9（官方要求，特殊字符会出问题）
DB_PASSWORD=CHANGE_ME_RANDOM_HEX

# 以下无需改动
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
