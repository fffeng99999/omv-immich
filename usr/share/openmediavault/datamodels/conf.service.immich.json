{
	"type": "config",
	"id": "conf.service.immich",
	"title": "Immich",
	"queryinfo": {
		"xpath": ".//services/immich",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"version": {
			"type": "string",
			"default": "v3.2.4"
		},
		"port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"default": 2283
		},
		"timeZone": {
			"type": "string",
			"default": "Etc/UTC"
		},
		"composeDirRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"uploadRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"dbRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"dbPassword": {
			"type": "string",
			"default": ""
		},
		"dbUsername": {
			"type": "string",
			"default": "postgres"
		},
		"dbDatabaseName": {
			"type": "string",
			"default": "immich"
		},
		"mlEnable": {
			"type": "boolean",
			"default": false
		}
	}
}
