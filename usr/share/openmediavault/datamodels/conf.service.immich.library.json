{
	"type": "config",
	"id": "conf.service.immich.library",
	"title": "Immich external library",
	"queryinfo": {
		"xpath": ".//services/immich/libraries/library",
		"iterable": true,
		"idproperty": "uuid"
	},
	"properties": {
		"uuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"sharedfolderref": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"containerPath": {
			"type": "string",
			"default": "/mnt/extlib"
		},
		"readonly": {
			"type": "boolean",
			"default": true
		}
	}
}
