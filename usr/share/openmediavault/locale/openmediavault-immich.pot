msgid "Stack file (Compose plugin)"
msgstr ""

msgid "Stack file location. The stack files are rendered by the Compose plugin into its shared folder and are managed there, so this path cannot be changed here. Set the folder in Services -> Compose -> Settings."
msgstr ""

msgid "Service"
msgstr ""

msgid "Enabled"
msgstr ""

msgid "Automatically manage the stack from OMV. On Apply the stack is (re)created; disabling the service removes the containers on Apply (photos and database are kept)."
msgstr ""

msgid "Version"
msgstr ""

msgid "Immich version tag"
msgstr ""

msgid "Docker image tag for immich-server and the machine-learning service (e.g. release or v3.2.4). 'release' follows the latest stable release. Prefer pinning a specific version; upgrade with the Upgrade button or change the tag here and Apply."
msgstr ""

msgid "Enable machine learning"
msgstr ""

msgid "Adds the immich-machine-learning container for face recognition, smart search and OCR. Requires 4 GB+ of RAM in addition to the base stack."
msgstr ""

